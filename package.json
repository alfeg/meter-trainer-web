{
  "name": "meter-trainer-web",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "description": "Train AI-on-the-edge digit models in the browser; builds to one HTML file served from the device SD card.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gzip.mjs",
    "check": "node scripts/node-check.mjs",
    "check:i18n": "node scripts/i18n-keys.mjs"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "fflate": "0.8.3",
    "flatbuffers": "24.3.25",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "jpeg-js": "0.4.4",
    "puppeteer-core": "^25.14.0",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alfeg/meter-trainer-web.git"
  }
}
